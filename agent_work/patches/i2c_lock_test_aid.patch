+const char* Ms5607Mmc5603SensorPackage::induceBusLockForTest() {
+    // The barometer is mid-conversion here (read() restarts one every tick) and doesn't ACK until it
+    // finishes - let it, so the lock is the barometer's, like the one seen on hardware. Fall back to
+    // the IMU if it still won't answer.
+    delay(10);
+    Wire.end();
+    I2cTestLockResult result = induceI2cLockForTest(PIN_WIRE_SDA, PIN_WIRE_SCL, MS5607_ADDR, MS5607_ADC_READ);
+    bool byImu = false;
+    if (result == I2cTestLockResult::NoAck || result == I2cTestLockResult::OnlyOnes) {
+        result = induceI2cLockForTest(PIN_WIRE_SDA, PIN_WIRE_SCL, m_imuType == ImuType::ICM20602 ? ICM20602_ADDR : ICM42605_ADDR);
+        byImu = true;
+    }
+    Wire.begin(); // peripheral back, bus still held - the next read() finds it that way
+    Wire.setClock(400000);
+    switch (result) {
+        case I2cTestLockResult::Locked: return byImu ? "I2C bus locked by the IMU" : "I2C bus locked by the barometer";
+        case I2cTestLockResult::BusAlreadyHeld: return "Couldn't lock the I2C bus: already held";
+        case I2cTestLockResult::NoAck: return "Couldn't lock the I2C bus: no device ACKed";
+        default: return "Couldn't lock the I2C bus: devices only sent 1 bits";
+    }
+}
