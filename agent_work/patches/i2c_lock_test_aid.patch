+/**
+ * @brief Test aid: leaves the device at `address` holding SDA low, the way a reset in the middle of a
+ * read does, so recoverI2cBus() can be exercised on real hardware.
+ * @details Bit-bangs a START and a read of `address` (optionally preceded by writing `command`, then a
+ * repeated START - e.g. the MS5607's ADC read), clocks the address and ACK, then stops clocking at the
+ * first data bit the device drives low - it keeps driving it until it gets more clocks.
+ * Same pin rules as recoverI2cBus(). Not for flight code.
+ */
+enum class I2cTestLockResult : uint8_t { Locked, BusAlreadyHeld, NoAck, OnlyOnes };
+
+inline I2cTestLockResult induceI2cLockForTest(const uint8_t sdaPin, const uint8_t sclPin, const uint8_t address, const int16_t command = -1) {
+    constexpr uint32_t HALF_PERIOD_US = 5;
+    auto release = [](uint8_t pin) { pinMode(pin, INPUT_PULLUP); };
+    auto drive = [](uint8_t pin) { digitalWrite(pin, LOW); pinMode(pin, OUTPUT); };
+    // Sends one byte (SCL low on entry and exit) and returns whether the device ACKed it
+    auto sendByte = [&](uint8_t value) {
+        for (int bit = 7; bit >= 0; bit--) {
+            if (value & (1 << bit)) release(sdaPin); else drive(sdaPin);
+            delayMicroseconds(HALF_PERIOD_US);
+            release(sclPin);
+            delayMicroseconds(HALF_PERIOD_US);
+            drive(sclPin);
+        }
+        release(sdaPin); // device ACKs by pulling SDA low on this clock
+        delayMicroseconds(HALF_PERIOD_US);
+        release(sclPin);
+        delayMicroseconds(HALF_PERIOD_US);
+        const bool acked = digitalRead(sdaPin) == LOW;
+        drive(sclPin);
+        return acked;
+    };
+    auto start = [&]() { // START (or repeated START): SDA falls while SCL is high
+        release(sdaPin);
+        delayMicroseconds(HALF_PERIOD_US);
+        release(sclPin);
+        delayMicroseconds(HALF_PERIOD_US);
+        drive(sdaPin);
+        delayMicroseconds(HALF_PERIOD_US);
+        drive(sclPin);
+    };
+    release(sdaPin);
+    release(sclPin);
+    delayMicroseconds(HALF_PERIOD_US);
+    if (digitalRead(sdaPin) == LOW || digitalRead(sclPin) == LOW) return I2cTestLockResult::BusAlreadyHeld;
+
+    bool acked = true;
+    if (command >= 0) {
+        start();
+        acked = sendByte((uint8_t)(address << 1)) && sendByte((uint8_t)command);
+    }
+    if (acked) {
+        start();
+        acked = sendByte((uint8_t)((address << 1) | 1));
+    }
+    if (!acked) {
+        release(sdaPin); // STOP so the bus is left clean
+        delayMicroseconds(HALF_PERIOD_US);
+        drive(sdaPin);
+        delayMicroseconds(HALF_PERIOD_US);
+        release(sclPin);
+        delayMicroseconds(HALF_PERIOD_US);
+        release(sdaPin);
+        return I2cTestLockResult::NoAck;
+    }
+
+    // The device now shifts data out while SCL is low - stop at the first 0 bit it drives
+    for (int byte = 0; byte < 3; byte++) {
+        for (int bit = 0; bit < 8; bit++) {
+            delayMicroseconds(HALF_PERIOD_US);
+            if (digitalRead(sdaPin) == LOW) {
+                release(sclPin); // leave SCL idle-high: the device keeps holding SDA, like after a reset
+                return I2cTestLockResult::Locked;
+            }
+            release(sclPin);
+            delayMicroseconds(HALF_PERIOD_US);
+            drive(sclPin);
+        }
+        drive(sdaPin); // ACK so it sends another byte
+        delayMicroseconds(HALF_PERIOD_US);
+        release(sclPin);
+        delayMicroseconds(HALF_PERIOD_US);
+        drive(sclPin);
+        release(sdaPin);
+    }
+    release(sclPin);
+    return I2cTestLockResult::OnlyOnes; // device only sent 1s - nothing to hold
+}
